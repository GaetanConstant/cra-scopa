# Clé de signature des jetons JWT.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Envoi d'emails --------------------------------------------------------
# Deux fournisseurs possibles, le code est le même : SMTP sur 587 + STARTTLS.
#
# Gmail — le plus rapide à mettre en place. Exige la validation en deux
# étapes puis un « mot de passe d'application » de 16 caractères ; le mot de
# passe du compte est refusé. L'expéditeur affiché sera l'adresse Gmail :
# Gmail réécrit l'en-tête From si l'adresse ne lui appartient pas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=scopa@gmail.com
SMTP_PASSWORD=
SMTP_FROM=CRA SCOPA <scopa@gmail.com>
#
# OVH MX Plan — pour envoyer sous le domaine scopa.co. Créer une boîte
# dédiée, puis vérifier SPF et activer DKIM dans la zone DNS, sans quoi les
# messages partent en indésirables.
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_USER=no-reply@scopa.co
# SMTP_PASSWORD=
# SMTP_FROM=CRA SCOPA <no-reply@scopa.co>

# URL publique de l'application, mise dans le bouton des emails.
APP_BASE_URL=https://cra.scopa.co

# MAIL_ENABLED=false coupe tout envoi, tentative de connexion comprise.
# MAIL_DRY_RUN=true construit et journalise le message sans l'envoyer :
# c'est le mode d'un premier essai en production.
MAIL_ENABLED=false
MAIL_DRY_RUN=true
