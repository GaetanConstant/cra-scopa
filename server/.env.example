# Clé de signature des jetons JWT.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Envoi d'emails --------------------------------------------------------
# Boîte MX Plan OVH dédiée. L'identifiant est l'adresse complète.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=no-reply@scopa.co
SMTP_PASSWORD=
SMTP_FROM=CRA SCOPA <no-reply@scopa.co>

# URL publique de l'application, mise dans le bouton des emails.
APP_BASE_URL=https://cra.scopa.co

# MAIL_ENABLED=false coupe tout envoi, tentative de connexion comprise.
# MAIL_DRY_RUN=true construit et journalise le message sans l'envoyer :
# c'est le mode d'un premier essai en production.
MAIL_ENABLED=false
MAIL_DRY_RUN=true
