[Unit]
Description=Rappel de clôture du CRA

[Timer]
# Le job tourne tous les jours et décide lui-même : il n'agit que le dernier
# jour ouvré du mois, puis le 3 du mois suivant. Mettre ce calendrier dans
# systemd obligerait à y encoder les jours fériés.
OnCalendar=*-*-* 09:00
Persistent=true

[Install]
WantedBy=timers.target
